# DRISHTI-3D backend configuration.
# Copy to .env and edit. Defaults run the WHOLE pipeline in mock mode so
# the app works on a laptop with no GPU, no COLMAP, and no model weights.

# ---- Mock flags (guide section 7) ----
# Keep these true for a reliable demo. Flip individually to true integration
# once a real module is installed and verified.
USE_MOCK_VISION=true
USE_MOCK_RECONSTRUCTION=true
USE_MOCK_AI=true
USE_MOCK_ANALYTICS=true

# ---- Paths ----
DATA_DIR=data
DEMO_PROJECT_ID=demo_001

# ---- Server ----
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ---- Real reconstruction (Person 3), only used when USE_MOCK_RECONSTRUCTION=false ----
COLMAP_PATH=colmap
USE_GPU=true
MATCHER_TYPE=sequential

# ---- Real AI (Person 4), only used when USE_MOCK_AI=false ----
DETECTION_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.40
