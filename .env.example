# Lumina3D backend configuration.
# Copy to .env and edit.

# ---- Processing flags ----
USE_MOCK_VISION=false
USE_MOCK_RECONSTRUCTION=false
USE_MOCK_AI=false
USE_MOCK_ANALYTICS=false

# ---- Paths ----
DATA_DIR=data
DEMO_PROJECT_ID=demo_001

# ---- Server ----
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ---- Reconstruction & Photogrammetry ----
COLMAP_PATH=tools/colmap/bin/colmap.exe
USE_GPU=true
MATCHER_TYPE=sequential
DENSE_RECONSTRUCTION_ENABLED=true
DENSE_ENGINE=auto
DENSE_PROFILE=balanced

# ---- AI & Object Detection ----
DETECTION_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.40
MASK_DYNAMIC_OBJECTS=true
