# Pretrained YOLO weights (Ultralytics model name or local .pt path)
DETECTION_MODEL=yolov8n.pt

# Minimum YOLO confidence to keep a detection. Tune against the actual demo video.
DETECTION_CONFIDENCE=0.40

# Use CUDA if available, else fall back to CPU automatically
USE_GPU=true

# When true, skip the real model entirely and return demo/objects.json
# with the exact same schema ΓÇö lets Person 5 build against this before
# the real detector is running.
USE_MOCK_AI=false
