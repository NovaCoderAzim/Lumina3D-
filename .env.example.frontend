# Frontend (Vite) configuration. Copy to .env.local to override.

# Demo mode (default true): the UI runs standalone with precomputed data.
# Set to false to drive the real FastAPI backend via src/lib/api.ts.
VITE_DEMO_MODE=true

# Where the API lives. Default '/api' is proxied to the backend in dev
# (see vite.config.ts). In production, point this at your backend origin.
VITE_API_BASE_URL=/api

# Dev-only: backend origin the Vite proxy forwards /api to.
VITE_BACKEND_URL=http://127.0.0.1:8000
